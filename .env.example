# Public identifiers, never API tokens. Set both in Vercel after creating Sanity.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Exact HTTPS production origin after domain purchase. No trailing slash.
NEXT_PUBLIC_SITE_URL=
# Leave off on previews. Enable only for the verified permanent public domain.
SITE_INDEXABLE=false
GOOGLE_SITE_VERIFICATION=
